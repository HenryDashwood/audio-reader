<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this, playback stops the moment the screen locks, which would
	     make the app useless in a pocket. Declared here rather than via
	     INFOPLIST_KEY_UIBackgroundModes, which did not survive the build. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The backend is deployed over HTTPS, so this app needs neither an App
	     Transport Security exemption nor local-network access. Both were here
	     while the backend ran on a Mac on the same Wi-Fi; asking for
	     permissions the app does not use is a needless privacy prompt and a
	     poor look at App Store review. -->
</dict>
</plist>
