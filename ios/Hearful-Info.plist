<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this, playback stops the moment the screen locks, which would
	     make the app useless in a pocket. Declared here rather than via
	     INFOPLIST_KEY_UIBackgroundModes, which did not survive the build. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- iPhone ProMotion displays otherwise cap this app at the 60 Hz system
	     default. UIKit and WebKit can pace scrolling at the display's current
	     refresh rate once the full range is available. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- The backend is deployed over HTTPS, so this app needs neither an App
	     Transport Security exemption nor local-network access. Both were here
	     while the backend ran on a Mac on the same Wi-Fi; asking for
	     permissions the app does not use is a needless privacy prompt and a
	     poor look at App Store review. -->

	<!-- The app shipped to testers as Hearful before becoming Magpie. Keeping
	     the old name as a Siri alternative means "ask Hearful" keeps working
	     for anyone whose habit predates the rename. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Hearful</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>hear full</string>
		</dict>
	</array>
	<!-- The only cryptography here is HTTPS, which is exempt from export
	     compliance. Declaring it up front means App Store Connect stops
	     asking the same question on every single upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
